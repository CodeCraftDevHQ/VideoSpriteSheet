<Window x:Class="VideoSpriteSheet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:VideoSpriteSheet.Services"
        Title="{loc:T AppTitle}"
        Width="1100" Height="860" MinWidth="900" MinHeight="660"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,24,24"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#D9D9D9">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,12,12"/>
                                <RectangleGeometry Rect="12,12,12,12"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="470"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Button x:Name="SettingsButton" Content="{loc:T Settings}" HorizontalAlignment="Left" Padding="14,4" Margin="0,0,0,10" Click="Settings_Click"/>

                <GroupBox Header="{loc:T GroupInput}" Margin="0,0,0,10" Padding="8">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button x:Name="BrowseVideoButton" DockPanel.Dock="Left" Content="{loc:T BrowseVideo}" Padding="12,4" Margin="6,0,0,0" Click="BrowseVideo_Click"/>
                            <TextBox x:Name="VideoPathBox" FlowDirection="LeftToRight" IsReadOnly="True"/>
                        </DockPanel>
                        <TextBlock Text="{loc:T DropHint}" Foreground="Gray" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <TextBlock x:Name="VideoInfoText" Foreground="Gray" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <DockPanel>
                            <Button x:Name="BrowseOutputButton" DockPanel.Dock="Left" Content="{loc:T BrowseOutput}" Padding="12,4" Margin="6,0,0,0" Click="BrowseOutput_Click"/>
                            <TextBox x:Name="OutputPathBox" FlowDirection="LeftToRight"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{loc:T GroupFrames}" Margin="0,0,0,10" Padding="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource Label}" Text="{loc:T FromSec}"/>
                            <TextBox x:Name="StartTimeBox" Width="80" FlowDirection="LeftToRight" TextChanged="Estimate_Changed"/>
                            <TextBlock Style="{StaticResource Label}" Text="{loc:T ToSec}" Margin="16,0,8,0"/>
                            <TextBox x:Name="EndTimeBox" Width="80" FlowDirection="LeftToRight" TextChanged="Estimate_Changed"/>
                        </StackPanel>
                        <TextBlock Text="{loc:T TimeHint}" Foreground="Gray" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource Label}" Text="{loc:T EveryNth}"/>
                            <TextBox x:Name="StepBox" Text="1" Width="70" TextChanged="Estimate_Changed"/>
                            <TextBlock x:Name="EstimateText" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Style="{StaticResource Label}" Text="{loc:T ImageSize}"/>
                            <TextBlock x:Name="ScaleText" DockPanel.Dock="Left" Width="45" VerticalAlignment="Center" Text="100%"/>
                            <Slider x:Name="ScaleSlider" Minimum="10" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="ScaleSlider_ValueChanged"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{loc:T GroupBg}" Margin="0,0,0,10" Padding="8">
                    <StackPanel>
                        <CheckBox x:Name="RemoveBgCheck" Content="{loc:T RemoveBg}" IsChecked="True" Margin="0,4" Checked="RemoveBg_Changed" Unchecked="RemoveBg_Changed"/>
                        <StackPanel x:Name="BgPanel">
                            <DockPanel Margin="0,6,0,6">
                                <Button x:Name="BrowseModelButton" DockPanel.Dock="Left" Content="{loc:T SelectModel}" Padding="12,4" Margin="6,0,0,0" Click="BrowseModel_Click"/>
                                <TextBox x:Name="ModelPathBox" FlowDirection="LeftToRight"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button x:Name="DownloadModelButton" DockPanel.Dock="Left" Content="{loc:T Download}" Padding="12,4" Margin="6,0,0,0" Click="DownloadModel_Click"/>
                                <ComboBox x:Name="DownloadModelCombo" FlowDirection="LeftToRight"/>
                            </DockPanel>
                            <ProgressBar x:Name="DownloadProgress" Height="12" Minimum="0" Maximum="1" Margin="0,0,0,6" Visibility="Collapsed"/>
                            <TextBlock Text="{loc:T ModelNote}" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,6"/>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Style="{StaticResource Label}" Text="{loc:T Preset}"/>
                                <ComboBox x:Name="PresetCombo" SelectedIndex="0">
                                    <ComboBoxItem Content="{loc:T PresetRmbg}"/>
                                    <ComboBoxItem Content="{loc:T PresetImageNet}"/>
                                </ComboBox>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Style="{StaticResource Label}" Text="{loc:T Sharpness}"/>
                                <TextBlock x:Name="SharpText" DockPanel.Dock="Left" Width="45" VerticalAlignment="Center" Text="2.0"/>
                                <Slider x:Name="SharpSlider" Minimum="1" Maximum="4" Value="2" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="SharpSlider_ValueChanged"/>
                            </DockPanel>
                            <CheckBox x:Name="GpuCheck" Content="{loc:T UseGpu}" IsChecked="True" Margin="0,4"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{loc:T GroupOutput}" Margin="0,0,0,10" Padding="8">
                    <StackPanel>
                        <CheckBox x:Name="SaveFramesCheck" Content="{loc:T SaveFrames}" Margin="0,4"/>
                        <CheckBox x:Name="SaveSheetCheck" Content="{loc:T SaveSheet}" IsChecked="True" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Label}" Text="{loc:T Columns}"/>
                            <TextBox x:Name="ColumnsBox" Text="8" Width="60"/>
                            <TextBlock Style="{StaticResource Label}" Text="{loc:T Padding}" Margin="16,0,8,0"/>
                            <TextBox x:Name="PaddingBox" Text="0" Width="60"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartButton" Content="{loc:T Start}" Padding="28,8" FontWeight="Bold" Click="Start_Click"/>
                    <Button x:Name="CancelButton" Content="{loc:T Cancel}" Padding="20,8" Margin="6,0,0,0" IsEnabled="False" Click="Cancel_Click"/>
                    <Button x:Name="OpenFolderButton" Content="{loc:T OpenFolder}" Padding="14,8" Margin="6,0,0,0" IsEnabled="False" Click="OpenFolder_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="#BBB" BorderThickness="1" Background="{StaticResource Checker}" FlowDirection="LeftToRight">
                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <ProgressBar x:Name="MainProgress" Height="18" Minimum="0" Maximum="1"/>
                <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
