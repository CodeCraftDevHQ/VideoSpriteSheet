<Window x:Class="VideoSpriteSheet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ویدیو به اسپرایت‌شیت"
        Width="1100" Height="780" MinWidth="900" MinHeight="640"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,24,24"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#D9D9D9">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,12,12"/>
                                <RectangleGeometry Rect="12,12,12,12"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="ورودی و خروجی">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button x:Name="BrowseVideoButton" DockPanel.Dock="Left" Content="انتخاب ویدیو" Click="BrowseVideo_Click"/>
                            <TextBox x:Name="VideoPathBox" FlowDirection="LeftToRight" IsReadOnly="True"/>
                        </DockPanel>
                        <TextBlock x:Name="VideoInfoText" Foreground="Gray" Margin="0,0,0,6"/>
                        <DockPanel>
                            <Button x:Name="BrowseOutputButton" DockPanel.Dock="Left" Content="پوشه خروجی" Click="BrowseOutput_Click"/>
                            <TextBox x:Name="OutputPathBox" FlowDirection="LeftToRight"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="گرفتن فریم‌ها">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource Label}" Text="هر چند فریم یک عکس:"/>
                            <TextBox x:Name="StepBox" Text="1" Width="70" TextChanged="Estimate_Changed"/>
                            <TextBlock x:Name="EstimateText" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Style="{StaticResource Label}" Text="اندازه هر عکس:"/>
                            <TextBlock x:Name="ScaleText" DockPanel.Dock="Left" Width="45" VerticalAlignment="Center" Text="100%"/>
                            <Slider x:Name="ScaleSlider" Minimum="10" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="ScaleSlider_ValueChanged"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="حذف بکگراند">
                    <StackPanel>
                        <CheckBox x:Name="RemoveBgCheck" Content="حذف بکگراند فعال باشد" IsChecked="True" Checked="RemoveBg_Changed" Unchecked="RemoveBg_Changed"/>
                        <StackPanel x:Name="BgPanel">
                            <DockPanel Margin="0,6,0,6">
                                <Button x:Name="BrowseModelButton" DockPanel.Dock="Left" Content="انتخاب مدل" Click="BrowseModel_Click"/>
                                <TextBox x:Name="ModelPathBox" FlowDirection="LeftToRight"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button x:Name="DownloadModelButton" DockPanel.Dock="Left" Content="دانلود مدل RMBG-1.4 (حدود ۱۷۶ مگابایت)" Click="DownloadModel_Click"/>
                                <ProgressBar x:Name="DownloadProgress" Height="14" Minimum="0" Maximum="1" Visibility="Collapsed"/>
                            </DockPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,6"
                                       Text="توجه: مجوز مدل RMBG-1.4 غیرتجاری است. برای استفاده تجاری مدل دیگری با مجوز مناسب (مثلاً BiRefNet با پیش‌تنظیم ImageNet) انتخاب کنید."/>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Style="{StaticResource Label}" Text="پیش‌تنظیم مدل:"/>
                                <ComboBox x:Name="PresetCombo" SelectedIndex="0">
                                    <ComboBoxItem Content="RMBG-1.4 (پیش‌فرض)"/>
                                    <ComboBoxItem Content="ImageNet (BiRefNet و مشابه)"/>
                                </ComboBox>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Style="{StaticResource Label}" Text="تیزی لبه‌ها:"/>
                                <TextBlock x:Name="SharpText" DockPanel.Dock="Left" Width="45" VerticalAlignment="Center" Text="2.0"/>
                                <Slider x:Name="SharpSlider" Minimum="1" Maximum="4" Value="2" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="SharpSlider_ValueChanged"/>
                            </DockPanel>
                            <CheckBox x:Name="GpuCheck" Content="استفاده از کارت گرافیک (DirectML)" IsChecked="True"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="خروجی">
                    <StackPanel>
                        <CheckBox x:Name="SaveFramesCheck" Content="ذخیره تک‌تک عکس‌ها (PNG)"/>
                        <CheckBox x:Name="SaveSheetCheck" Content="ذخیره به صورت اسپرایت‌شیت" IsChecked="True"/>
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Label}" Text="تعداد ستون:"/>
                            <TextBox x:Name="ColumnsBox" Text="8" Width="60"/>
                            <TextBlock Style="{StaticResource Label}" Text="فاصله (پیکسل):" Margin="16,0,8,0"/>
                            <TextBox x:Name="PaddingBox" Text="0" Width="60" HorizontalAlignment="Left"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartButton" Content="شروع" Padding="28,8" FontWeight="Bold" Margin="0" Click="Start_Click"/>
                    <Button x:Name="CancelButton" Content="لغو" Padding="20,8" IsEnabled="False" Click="Cancel_Click"/>
                    <Button x:Name="OpenFolderButton" Content="باز کردن پوشه خروجی" Padding="14,8" IsEnabled="False" Click="OpenFolder_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="#BBB" BorderThickness="1" Background="{StaticResource Checker}">
                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <ProgressBar x:Name="MainProgress" Height="18" Minimum="0" Maximum="1"/>
                <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap" Text="آماده"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
